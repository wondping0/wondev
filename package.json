{
  "name": "wondev",
  "version": "0.9.9",
  "description": "Write your AI agent knowledge once. Compile it to every agent's config format.",
  "keywords": [
    "ai",
    "agent",
    "claude",
    "cursor",
    "copilot",
    "agents-md",
    "claude-md",
    "cli",
    "scaffold",
    "codegen"
  ],
  "license": "MIT",
  "author": "wondping0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wondping0/wondev.git"
  },
  "bugs": {
    "url": "https://github.com/wondping0/wondev/issues"
  },
  "homepage": "https://github.com/wondping0/wondev#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wondev": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
