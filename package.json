{
  "name": "wondev",
  "version": "1.3.0",
  "description": "Write your AI agent knowledge once. Compile it to every agent's config format.",
  "keywords": [
    "ai",
    "agent",
    "claude",
    "cursor",
    "copilot",
    "agents-md",
    "claude-md",
    "cli",
    "scaffold",
    "codegen"
  ],
  "license": "MIT",
  "author": "wondping0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wondping0/wondev.git"
  },
  "bugs": {
    "url": "https://github.com/wondping0/wondev/issues"
  },
  "homepage": "https://github.com/wondping0/wondev#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wondev": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "docs/knowledge.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/smoke-package.mjs",
    "test:upgrade": "node scripts/smoke-upgrade.mjs",
    "test:upgrade:previous": "node scripts/smoke-upgrade.mjs --from 1.2.0",
    "verify": "npm run typecheck && npm run build && npm run test:coverage",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
