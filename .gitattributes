# wondev's whole premise is byte-identical output across platforms, so the repository
# stores LF and checks out LF everywhere. Without this, a Windows checkout would rewrite
# the templates to CRLF and every hash in a Linux build would differ.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gz binary
# Vendored upstream resources retain their original bytes for pinned checksum verification.
templates/skills/ui-ux-pro-max/data/** -text
templates/skills/ui-ux-pro-max/scripts/** -text
templates/skills/webapp-testing/examples/** -text
templates/skills/webapp-testing/scripts/** -text
# Keep upstream whitespace too; vendor-skills.lock.json verifies the exact original.
templates/skills/ui-ux-pro-max/scripts/design_system.py whitespace=-blank-at-eol
